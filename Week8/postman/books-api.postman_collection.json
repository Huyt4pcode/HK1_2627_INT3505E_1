{
  "info": {
    "name": "Books API — Lab08 Starter",
    "description": "Lab 3: happy paths + error-cases/ (POST missing title, GET missing id). Newman-runnable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "books",
      "item": [
        {
          "name": "GET /books — initial list",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"body is array\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /books — create",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"DDIA\", \"author\": \"Kleppmann\", \"year\": 2017}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const book = pm.response.json();",
                  "pm.test(\"created book has expected fields\", () => pm.expect(book).to.have.all.keys(\"id\", \"title\", \"author\", \"year\", \"isbn\"));",
                  "pm.test(\"positive id saved as collection variable\", () => {",
                  "  pm.expect(book.id).to.be.above(0);",
                  "  pm.collectionVariables.set(\"book_id\", book.id);",
                  "  pm.expect(pm.collectionVariables.get(\"book_id\")).to.eql(book.id);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /books/{id} — read",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returned created book\", () => {",
                  "  const book = pm.response.json();",
                  "  pm.expect(book).to.have.all.keys(\"id\", \"title\", \"author\", \"year\", \"isbn\");",
                  "  pm.expect(String(book.id)).to.eql(pm.collectionVariables.get(\"book_id\"));",
                  "  pm.expect(book.title).to.eql(\"DDIA\");",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "PUT /books/{id} — replace",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"title\": \"DDIA revised\", \"author\": \"Kleppmann\", \"year\": 2017}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"book was updated\", () => {",
                  "  const book = pm.response.json();",
                  "  pm.expect(book.title).to.eql(\"DDIA revised\");",
                  "  pm.expect(String(book.id)).to.eql(pm.collectionVariables.get(\"book_id\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "DELETE /books/{id} — delete",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/{{book_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "{{book_id}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"204 No Content\", () => pm.response.to.have.status(204));",
                  "pm.test(\"empty body\", () => pm.expect(pm.response.text()).to.eql(\"\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "error-cases",
      "item": [
        {
          "name": "POST /books (missing title)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/books",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\"author\": \"Kleppmann\", \"year\": 2017}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"400 Bad Request\", () => pm.response.to.have.status(400));",
                  "pm.test(\"error body has validation code and message\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql(\"VALIDATION_ERROR\");",
                  "  pm.expect(body.message).to.be.a(\"string\").and.not.empty;",
                  "});",
                  "pm.test(\"validation identifies missing title\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.errors.some((item) => item.field === \"title\")).to.eql(true);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /books/9999 (not found)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/books/9999",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "books",
                "9999"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"404 Not Found\", () => pm.response.to.have.status(404));",
                  "pm.test(\"error body has not-found code and message\", () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.code).to.eql(\"NOT_FOUND\");",
                  "  pm.expect(body.message).to.eql(\"Book not found\");",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "book_id",
      "value": ""
    }
  ]
}